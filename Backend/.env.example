# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prepai
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prepai

# Server Port
PORT=3000

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Groq Cloud API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (Recommended: openai/gpt-oss-120b or openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

